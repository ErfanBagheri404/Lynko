{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Lynko",
  "version": "0.1.0",
  "identifier": "dev.lynko.app",
  "build": {
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Lynko",
        "width": 1100,
        "height": 750,
        "minWidth": 800,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.ico"],
    "category": "Utility"
  }
}
