<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0A0B0D">

    <!-- header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="24dp"
        android:paddingBottom="16dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="SCREEN"
            android:textColor="#555658"
            android:fontFamily="@font/lynko_ui"
            android:textSize="11sp"
            android:textStyle="bold"
            android:letterSpacing="0.14" />

        <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="2" android:background="#15161A" />

        <TextView
            android:id="@+id/screenState"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:text="idle"
            android:textColor="#555658"
            android:fontFamily="monospace"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- preview canvas -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#0E0F12">

        <ImageView
            android:id="@+id/previewImg"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitCenter"
            android:contentDescription="@string/nav_screen" />

        <TextView
            android:id="@+id/previewHint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text=""
            android:textColor="#555658"
            android:fontFamily="@font/lynko_ui"
            android:textSize="13sp"
            android:gravity="center" />
    </FrameLayout>

    <!-- fps + quality row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="10dp"
        android:paddingBottom="10dp"
        android:background="#0E0F12">

        <TextView
            android:id="@+id/fpsText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="0 fps"
            android:textColor="#555658"
            android:fontFamily="monospace"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/resText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=""
            android:textColor="#555658"
            android:fontFamily="monospace"
            android:textSize="11sp" />
    </LinearLayout>

    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#15161A" />

    <!-- primary action -->
    <Button
        android:id="@+id/btnToggle"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:layout_marginTop="12dp"
        android:text="Start mirroring"
        android:textColor="#1A1006"
        android:fontFamily="@font/lynko_ui"
        android:textSize="15sp"
        android:textStyle="bold"
        android:letterSpacing="0.02"
        android:background="@drawable/btn_amber"
        android:stateListAnimator="@null" />

    <Space android:layout_width="match_parent" android:layout_height="16dp" />
</LinearLayout>
