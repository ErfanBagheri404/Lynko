<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/appRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0A0B0D">

    <!-- Home tab (scrollable) -->
    <ScrollView
        android:id="@+id/homeContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:visibility="visible">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingEnd="24dp">

            <!-- ================= header lane ================= -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="56dp"
                android:text="lynko"
                android:textColor="#E8E6E1"
                android:fontFamily="@font/lynko_ui"
                android:textSize="34sp"
                android:textStyle="bold"
                android:letterSpacing="-0.03" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:layout_marginBottom="28dp"
                android:text="your phone, on your desktop"
                android:textColor="#8B8D90"
                android:fontFamily="@font/lynko_ui"
                android:textSize="13sp" />

            <!-- ================= 01 · SIGNAL ================= -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="01" android:textColor="#555658" android:fontFamily="monospace" android:textSize="11sp" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginStart="10dp" android:text="SIGNAL" android:textColor="#555658"
                    android:fontFamily="@font/lynko_ui" android:textSize="11sp" android:textStyle="bold" android:letterSpacing="0.14" />
                <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" android:layout_marginStart="10dp" android:background="#15161A" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/statusCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="vertical"
                android:background="@drawable/status_card"
                android:padding="18dp">

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="center_vertical">
                    <View android:id="@+id/statusDot" android:layout_width="8dp" android:layout_height="8dp" android:background="@drawable/dot_idle" />
                    <TextView android:id="@+id/statusTitle" android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:layout_marginStart="12dp" android:text="Not running" android:textColor="#E8E6E1"
                        android:fontFamily="@font/lynko_ui" android:textSize="16sp" android:textStyle="bold" />
                </LinearLayout>
                <TextView android:id="@+id/statusSub" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="8dp" android:text="" android:textColor="#8B8D90"
                    android:fontFamily="@font/lynko_ui" android:textSize="13sp" android:lineSpacingExtra="3dp" />
                <TextView android:id="@+id/pinText" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="14dp" android:gravity="center" android:text="" android:textColor="#FFB454"
                    android:fontFamily="monospace" android:textSize="20sp" android:letterSpacing="0.3" android:visibility="gone" />
            </LinearLayout>

            <!-- ================= 02 · REQUIRES ================= -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="28dp" android:orientation="horizontal" android:gravity="center_vertical">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="02" android:textColor="#555658" android:fontFamily="monospace" android:textSize="11sp" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginStart="10dp" android:text="REQUIRES" android:textColor="#555658"
                    android:fontFamily="@font/lynko_ui" android:textSize="11sp" android:textStyle="bold" android:letterSpacing="0.14" />
                <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" android:layout_marginStart="10dp" android:background="#15161A" />
            </LinearLayout>

            <!-- perm: screen -->
            <LinearLayout android:id="@+id/permScreen" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="center_vertical" android:minHeight="48dp" android:paddingTop="12dp" android:paddingBottom="12dp">
                <TextView android:id="@+id/permScreenIcon" android:layout_width="22dp" android:layout_height="22dp"
                    android:gravity="center" android:text="•" android:textColor="#FFB454" android:textSize="15sp" android:fontFamily="monospace" android:includeFontPadding="false" />
                <TextView android:id="@+id/permScreenText" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginStart="12dp" android:text="" android:textColor="#8B8D90" android:fontFamily="@font/lynko_ui" android:textSize="14sp" />
            </LinearLayout>
            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#15161A" />

            <!-- perm: a11y -->
            <LinearLayout android:id="@+id/permA11y" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="center_vertical" android:minHeight="48dp" android:paddingTop="12dp" android:paddingBottom="12dp">
                <TextView android:id="@+id/permA11yIcon" android:layout_width="22dp" android:layout_height="22dp"
                    android:gravity="center" android:text="•" android:textColor="#FFB454" android:textSize="15sp" android:fontFamily="monospace" android:includeFontPadding="false" />
                <TextView android:id="@+id/permA11yText" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginStart="12dp" android:text="" android:textColor="#8B8D90" android:fontFamily="@font/lynko_ui" android:textSize="14sp" />
            </LinearLayout>
            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#15161A" />

            <!-- perm: battery -->
            <LinearLayout android:id="@+id/permBattery" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="center_vertical" android:minHeight="48dp" android:paddingTop="12dp" android:paddingBottom="12dp">
                <TextView android:id="@+id/permBatteryIcon" android:layout_width="22dp" android:layout_height="22dp"
                    android:gravity="center" android:text="•" android:textColor="#FFB454" android:textSize="15sp" android:fontFamily="monospace" android:includeFontPadding="false" />
                <TextView android:id="@+id/permBatteryText" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginStart="12dp" android:text="" android:textColor="#8B8D90" android:fontFamily="@font/lynko_ui" android:textSize="14sp" />
            </LinearLayout>
            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#15161A" />

            <!-- perm: notifications -->
            <LinearLayout android:id="@+id/permNotif" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="center_vertical" android:minHeight="48dp" android:paddingTop="12dp" android:paddingBottom="12dp">
                <TextView android:id="@+id/permNotifIcon" android:layout_width="22dp" android:layout_height="22dp"
                    android:gravity="center" android:text="•" android:textColor="#FFB454" android:textSize="15sp" android:fontFamily="monospace" android:includeFontPadding="false" />
                <TextView android:id="@+id/permNotifText" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginStart="12dp" android:text="" android:textColor="#8B8D90" android:fontFamily="@font/lynko_ui" android:textSize="14sp" />
            </LinearLayout>

            <!-- ================= 03 · START ================= -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="28dp" android:orientation="horizontal" android:gravity="center_vertical">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="03" android:textColor="#555658" android:fontFamily="monospace" android:textSize="11sp" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginStart="10dp" android:text="START" android:textColor="#555658"
                    android:fontFamily="@font/lynko_ui" android:textSize="11sp" android:textStyle="bold" android:letterSpacing="0.14" />
                <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" android:layout_marginStart="10dp" android:background="#15161A" />
            </LinearLayout>

            <Button
                android:id="@+id/startBtn"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="12dp"
                android:text="Start Lynko"
                android:textColor="#1A1006"
                android:fontFamily="@font/lynko_ui"
                android:textSize="15sp"
                android:textStyle="bold"
                android:letterSpacing="0.02"
                android:background="@drawable/btn_amber"
                app:backgroundTint="@null"
                android:stateListAnimator="@null" />

            <Space android:layout_width="match_parent" android:layout_height="16dp" />
        </LinearLayout>
    </ScrollView>

    <!-- Screen tab (hidden initially) -->
    <FrameLayout
        android:id="@+id/screenContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:visibility="gone" />

    <ScrollView android:id="@+id/settingsContainer" android:layout_width="match_parent"
        android:layout_height="0dp" android:layout_weight="1" android:visibility="gone" android:fillViewport="true">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:padding="24dp">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="@string/nav_settings" android:textColor="#E8E6E1" android:textSize="24sp"
                android:textStyle="bold" android:fontFamily="@font/lynko_ui" />
            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/motionToggle"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:minHeight="48dp" android:layout_marginTop="16dp"
                android:text="@string/interface_animations" android:textColor="#8B8D90"
                android:fontFamily="@font/lynko_ui" android:textSize="14sp" />
            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#303236" />
            <Button android:id="@+id/audioPermission" android:layout_width="match_parent" android:layout_height="56dp"
                android:text="@string/audio_permission" android:textColor="#FFB454"
                android:fontFamily="@font/lynko_ui" android:textStyle="bold" android:textSize="15sp"
                android:background="?attr/selectableItemBackground" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/audio_permission_hint"
                android:textColor="#8B8D90" android:textSize="13sp" android:fontFamily="@font/lynko_ui" />
        </LinearLayout>
    </ScrollView>

    <!-- ================= bottom nav ================= -->
    <LinearLayout
        android:id="@+id/bottomNav"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="#0E0F12"
        android:orientation="vertical">

        <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#15161A" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/navHome"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true"
                android:paddingTop="6dp"
                android:paddingBottom="6dp">

                <ImageView
                    android:id="@+id/navHomeIcon"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_home"
                    android:contentDescription="@string/nav_home" />

                <TextView
                    android:id="@+id/navHomeLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/nav_home"
                    android:textColor="#FFB454"
                    android:fontFamily="@font/lynko_ui"
                    android:textSize="10sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <View android:layout_width="1dp" android:layout_height="match_parent" android:background="#15161A" />

            <LinearLayout
                android:id="@+id/navScreen"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true"
                android:paddingTop="6dp"
                android:paddingBottom="6dp">

                <ImageView
                    android:id="@+id/navScreenIcon"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_screen"
                    android:contentDescription="@string/nav_screen" />

                <TextView
                    android:id="@+id/navScreenLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/nav_screen"
                    android:textColor="#555658"
                    android:fontFamily="@font/lynko_ui"
                    android:textSize="10sp" />
            </LinearLayout>
            <View android:layout_width="1dp" android:layout_height="match_parent" android:background="#15161A" />
            <LinearLayout
                android:id="@+id/navSettings"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true"
                android:paddingTop="6dp"
                android:paddingBottom="6dp">

                <ImageView
                    android:id="@+id/navSettingsIcon"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_settings"
                    android:contentDescription="@string/nav_settings" />

                <TextView
                    android:id="@+id/navSettingsLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/nav_settings"
                    android:textColor="#555658"
                    android:fontFamily="@font/lynko_ui"
                    android:textSize="10sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
