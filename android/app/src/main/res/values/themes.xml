<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Lynko" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:statusBarColor">#0A0B0D</item>
        <item name="android:navigationBarColor">#0A0B0D</item>
        <item name="android:windowBackground">#0A0B0D</item>
        <item name="colorPrimary">#FFB454</item>
        <item name="colorOnPrimary">#1A1006</item>
        <item name="colorSecondary">#FFB454</item>
        <item name="android:colorAccent">#FFB454</item>
        <item name="colorControlActivated">#FFB454</item>
        <item name="colorControlNormal">#3A3D42</item>
        <item name="android:textColorPrimary">#E8E6E1</item>
        <item name="android:textColorSecondary">#8B8D90</item>
    </style>
    <!-- Dialogs stay dark even when the phone is in light mode: the app has no
         light surface, and a white alert made the changelog text invisible. -->
    <style name="Theme.Lynko.Dialog" parent="Theme.Material3.Dark.Dialog.Alert">
        <item name="colorPrimary">#FFB454</item>
        <item name="colorAccent">#FFB454</item>
        <item name="android:colorAccent">#FFB454</item>
        <item name="colorSurface">#131417</item>
        <item name="android:background">#131417</item>
        <item name="android:textColorPrimary">#E8E6E1</item>
        <item name="android:textColorSecondary">#8B8D90</item>
    </style>
</resources>
