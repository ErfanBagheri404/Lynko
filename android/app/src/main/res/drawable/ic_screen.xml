        android:strokeColor="#8B8D90"
        android:strokeWidth="1.5"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:pathData="M5,18l4,-4l3,3l4,-5l4,6" />
    <path
        android:fillColor="#8B8D90"
