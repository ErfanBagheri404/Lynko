        android:fillColor="@android:color/transparent"
        android:strokeColor="#8B8D90"
        android:strokeWidth="1.5"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:pathData="M4,4h16a1,1,0,0,1,1,1v14a1,1,0,0,1,-1,1h-16a1,1,0,0,1,-1,-1v-14a1,1,0,0,1,1,-1z" />
    <path
