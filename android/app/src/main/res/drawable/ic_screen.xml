<?xml version="1.0" encoding="utf-8"?>
<!-- Share tab mark: an outlined screen carrying a sparkline.
     The previous version put the screen rect and the sparkline in ONE path with
     fillColor set, so the sparkline subpath was implicitly closed and filled and
     the whole glyph rendered as a solid grey block. Keep fill and stroke on
     separate paths. -->
